# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Packaging and build outputs
*.egg-info/
build/
dist/
site/

# Virtual environments and uv local state
.venv/
.uv-venv/
.uv-venv-broken/
.venv-broken/
venv/
ENV/
env/
.uv-cache/
.python-version

# Local Griffin runtime state
.griffin/
runs/
*.log

# Secrets and local configuration
.env
.env.*
!.env.example

# Private or large biological data
# Keep small synthetic fixtures under data/examples/ tracked.
data/private/
*.vcf.gz
*.bcf
*.bam
*.bai
*.cram
*.crai
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.fa
*.fasta
*.fa.gz
*.fasta.gz

# Generated reports and exports
*.pdf
*.xlsx
*.xls

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*.temp
~$*

# Local source snapshots and developer-specific configuration.
.upstream/
openscience.jsonc
.tmp-runtime-smoke*/

# Griffin workspace dependencies, generated assets, and local runtime state.
griffin-next/node_modules/
griffin-next/.openscience/
griffin-next/.tmp/
griffin-next/.turbo/
griffin-next/griffin-dev*.log

# Scientific Runs is source code, not the root-level generated runs directory.
!griffin-next/backend/cli/src/science/runs/
!griffin-next/backend/cli/src/science/runs/**

# Catalog source code and manifests are tracked; bundled biological databases
# and large fixture datasets are fetched or supplied separately.
griffin-next/catalog/sources/**/data/
griffin-next/catalog/sources/**/references/database/
griffin-next/catalog/sources/**/references/string_cache/
griffin-next/catalog/sources/**/tests/data/
griffin-next/catalog/sources/**/assets/*.rds
