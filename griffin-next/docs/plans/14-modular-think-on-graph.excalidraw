      },
      "boundElements": [],
      "updated": 1786440000000,
      "link": null,
      "locked": false,
      "text": "Focused topic + one evidence intent?\nExamples: multi-hop paper lookup; related entities; prior-session connection.\n\u2192 Choose standard ToG.",
      "originalText": "Focused topic + one evidence intent?\nExamples: multi-hop paper lookup; related entities; prior-session connection.\n\u2192 Choose standard ToG.",
